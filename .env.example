# ========= LLM(OpenAI 兼容格式,任选一家) =========
# DeepSeek:    LLM_BASE_URL=https://api.deepseek.com/v1          LLM_MODEL=deepseek-chat
# 智谱GLM:     LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4  LLM_MODEL=glm-4.7 (示例)
# 通义Qwen:    LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
# SiliconFlow: LLM_BASE_URL=https://api.siliconflow.cn/v1        LLM_MODEL=deepseek-ai/DeepSeek-V3
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxx
LLM_MODEL=deepseek-chat
# 透传给 /chat/completions 的额外 JSON 体(可选)
# 通义 qwen3 系列关闭思考模式可省 ~90% 输出 token: {"enable_thinking": false}
LLM_EXTRA_BODY_JSON=

# ========= Embedding(OpenAI 兼容 /embeddings 接口) =========
# 留空则复用 LLM 的 base_url 与 api_key
EMBED_BASE_URL=
EMBED_API_KEY=
# 模型按所选平台填写,例如:
#   SiliconFlow: BAAI/bge-m3
#   通义: text-embedding-v4   (注意: 通义单请求最多 20 条, 超限会自动降批)
#   智谱: embedding-3
EMBED_MODEL=BAAI/bge-m3
# 单次嵌入请求的文本条数, 默认 10(保守值); SiliconFlow 可调大提速
EMBED_BATCH_SIZE=10

# ========= Rerank(可选,SiliconFlow/Jina 兼容 /rerank 接口) =========
RERANK_ENABLED=false
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_API_KEY=sk-xxxx
RERANK_MODEL=BAAI/bge-reranker-v2-m3
